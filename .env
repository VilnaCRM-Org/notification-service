# Development defaults for the local compose stack and for `cargo run`.
# LOCAL-ONLY placeholders. Nothing in this file is a secret; never reuse a value outside a developer machine.
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=info

LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SQS=http://${LOCALSTACK_HOST}:${LOCALSTACK_PORT}

KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_TOPIC=notifications
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_CLIENT_ID=notification-service
KAFKA_REQUEST_TIMEOUT=3s
KAFKA_CONNECT_TIMEOUT=2s
KAFKA_FETCH_MAX_WAIT=500ms
KAFKA_RETRY_DELAY=1s

EVENT_MAX_DATA_BYTES=65536
EVENT_WINDOW_MAX_EVENTS=100000
EVENT_WINDOW_MAX_BYTES=67108864
EVENT_WINDOW_START_EVENTS=100000
EVENT_REPLAY_MAX_EVENTS=1000000
EVENT_REPLAY_PERMITS=4
EVENT_TAIL_STALE_AFTER=10s
SUBSCRIBER_BUFFER=256
MAX_SUBSCRIBERS=100000
STREAM_KEEP_ALIVE=15s

STRUCTURIZR_PORT=8080
